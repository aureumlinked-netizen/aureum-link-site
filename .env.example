NEXT_PUBLIC_SITE_URL=
# Запасной ID трансляции. В обычной работе не нужен: эфир определяется
# на лету через /api/live. Заполняется, только если функция недоступна.
NEXT_PUBLIC_YOUTUBE_VIDEO_ID=
# Не переменная Next: задаётся в Cloudflare Pages (Settings -> Variables).
# Без неё сайт берёт эфир из RSS-фида, но не может подтвердить, что он идёт,
# и не показывает красную точку. С ней /api/live отвечает live/offline точно.
# YOUTUBE_API_KEY=
NEXT_PUBLIC_SITE_PASSWORD_HASH=
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_EMAILOCTOPUS_EMBED_SCRIPT_SRC=
NEXT_PUBLIC_EMAILOCTOPUS_EMBED_FORM_ID=
NEXT_PUBLIC_EMAILOCTOPUS_FORM_ACTION=
NEXT_PUBLIC_EMAILOCTOPUS_EMAIL_FIELD_NAME=email
NEXT_PUBLIC_EMAILOCTOPUS_HONEYPOT_NAME=
NEXT_PUBLIC_EMAILOCTOPUS_HIDDEN_FIELDS_JSON=
